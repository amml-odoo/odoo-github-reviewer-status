{
  "manifest_version": 3,
  "name": "GitHub Reviewer Leave Status",
  "version": "1.0.0",
  "description": "Shows whether a reviewer assigned to a GitHub PR is currently on leave.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://github.com/*",
    "https://www.odoo.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*/*/pull/*"],
      "js": ["src/content.js"],
      "css": ["src/styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "src/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
